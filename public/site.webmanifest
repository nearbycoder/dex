{
  "id": "/",
  "name": "Dex",
  "short_name": "Dex",
  "description": "Your durable agent: chats, a cloud VM, and generative UI.",
  "start_url": "/chat",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#09090b",
  "theme_color": "#09090b",
  "categories": ["productivity", "developer", "utilities"],
  "launch_handler": { "client_mode": "focus-existing" },
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/favicon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "New chat", "url": "/chat", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Machine", "short_name": "VM", "url": "/machine", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Usage", "url": "/usage", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] }
  ]
}
