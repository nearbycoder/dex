# Fingerprinted build output never changes at a given URL: cache it for a year without revalidating.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Icons and model logos change rarely; a day is plenty.
/models/*
  Cache-Control: public, max-age=86400
/icon-*
  Cache-Control: public, max-age=86400
/badge-96.png
  Cache-Control: public, max-age=86400

# The service worker must always be checked for updates.
/sw.js
  Cache-Control: no-cache
