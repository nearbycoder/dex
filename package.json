{
  "name": "dex",
  "private": true,
  "license": "MIT",
  "description": "Dex: a personal AI agent on Cloudflare. A monorepo: apps/web (the app, the Worker, and the agent), with room for apps/ios and apps/android.",
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @dex/web",
    "build": "npm run build -w @dex/web",
    "typecheck": "npm run typecheck -w @dex/web",
    "check:ops": "npm run check:ops -w @dex/web",
    "deploy": "npm run deploy -w @dex/web",
    "deploy:web": "npm run deploy -w @dex/web"
  },
  "overrides": {
    "undici": "^7.30.1",
    "katex": "^0.18.2"
  }
}
