{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dex",
  "main": "src/server.ts",
  "compatibility_date": "2026-10-17",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "observability": { "enabled": true },
  // Workers AI: powers the web_fetch and web_search tools.
  "ai": { "binding": "AI" },
  // One DexAgent per user. Pi Durable keeps every chat in the object's SQLite.
  "durable_objects": {
    "bindings": [{ "name": "DexAgent", "class_name": "DexAgent" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DexAgent"] }],
  // Password sign-in attempts per client IP.
  "ratelimits": [{ "name": "LOGIN_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }],
  "vars": {
    // Comma-separated GitHub logins allowed to sign in.
    "ALLOWED_GITHUB_USERS": "nearbycoder",
    // The account whose analytics the Usage page reads (with the CLOUDFLARE_API_TOKEN secret).
    "CLOUDFLARE_ACCOUNT_ID": "0a4ba75d9277c4e96b49255f3109e7b6"
  }
  // Secrets (wrangler secret put): AUTH_SECRET, GITHUB_CLIENT_ID, GITHUB_CLIENT_SECRET, optional CLINE_API_KEY,
  // OWNER_PASSWORD, BOAT_API_KEY, CLOUDFLARE_API_TOKEN (Account Analytics: Read).
}
