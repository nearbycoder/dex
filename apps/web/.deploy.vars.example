# Per-deployment settings `npm run deploy` passes to Wrangler as variables (not secrets). Copy to .deploy.vars.

# Comma-separated GitHub logins allowed to sign in. The first is the owner (password sign-in and the
# deployment's BOAT_API_KEY and OPENCODE_API_KEY are theirs). Required.
ALLOWED_GITHUB_USERS=your-github-login
# Optional: your Cloudflare account ID, for the Usage page (with the CLOUDFLARE_API_TOKEN secret).
CLOUDFLARE_ACCOUNT_ID=
# Optional: Web Push public key (its private half is the VAPID_PRIVATE_KEY secret). Generate a pair with:
#   npx @pushforge/builder vapid
VAPID_PUBLIC_KEY=
# Optional: custom domains, comma-separated, the main one first (e.g. example.com,www.example.com). Each needs a
# proxied DNS record in its zone on your Cloudflare account (any target; an AAAA record to 100:: is the usual
# placeholder). `npm run deploy` routes them to the Worker, and pages opened at any other address redirect to the main
# one. Point your GitHub OAuth app's callback at https://<main domain>/auth/github.
CUSTOM_DOMAIN=
