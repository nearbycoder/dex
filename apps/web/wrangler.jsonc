{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dex",
  "main": "src/server.ts",
  "compatibility_date": "2026-10-17",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  // Keep the workers.dev address with a custom domain too (Wrangler turns it off otherwise): API clients and MCP
  // connections keep working there, and its pages redirect to the custom domain.
  "workers_dev": true,
  "observability": { "enabled": true },
  // The build's static files, for the few the Worker serves itself (the landing page's tour, with byte ranges).
  "assets": { "binding": "ASSETS" },
  // Workers AI: powers the web_fetch and web_search tools.
  "ai": { "binding": "AI" },
  // One DexAgent per user. Pi Durable keeps every chat in the object's SQLite.
  "durable_objects": {
    "bindings": [{ "name": "DexAgent", "class_name": "DexAgent" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DexAgent"] }],
  // Password sign-in attempts per client IP.
  "ratelimits": [{ "name": "LOGIN_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }],
  // Videos and other media chats share (from a VM), served privately at /api/media/<key>.
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "dex-media" }],
  // Per-deployment settings. Leave these empty here: `npm run deploy` fills them from the gitignored .deploy.vars
  // (see .deploy.vars.example), so this file stays the same for everyone who deploys Dex.
  "vars": {
    // Comma-separated GitHub logins allowed to sign in. The first is the owner. Required to deploy.
    "ALLOWED_GITHUB_USERS": "",
    // Optional: the account whose analytics the Usage page reads (with the CLOUDFLARE_API_TOKEN secret).
    "CLOUDFLARE_ACCOUNT_ID": "",
    // Optional: Web Push, the public half of the VAPID key pair (the private half is the VAPID_PRIVATE_KEY secret).
    "VAPID_PUBLIC_KEY": "",
    // Optional: custom domains on your Cloudflare account, comma-separated, the main one first (e.g.
    // "example.com,www.example.com"). `npm run deploy` routes them to the Worker, and pages opened at any other
    // address (workers.dev, www) move to the main one.
    "CUSTOM_DOMAIN": ""
  }
  // Secrets (wrangler secret put): AUTH_SECRET, GITHUB_CLIENT_ID, GITHUB_CLIENT_SECRET, optional CLINE_API_KEY,
  // OWNER_PASSWORD, BOAT_API_KEY (the owner's VMs only: the first ALLOWED_GITHUB_USERS login), CLOUDFLARE_API_TOKEN (Account Analytics: Read), VAPID_PRIVATE_KEY (Web Push).
  // Push to the native apps (see src/agent/native-push.ts): APNS_KEY (.p8 text), APNS_KEY_ID, APNS_TEAM_ID, optional
  // APNS_TOPIC (the iOS bundle ID; default dev.trydex.Dex); FCM_SERVICE_ACCOUNT (a Firebase service account key's JSON).
}
